params.executor = "slurm"

// Pipeline release 1.5.0 validates its parameters with this plugin, which needs Nextflow 25.10 or later.
plugins {
    id 'nf-schema@2.7.3'
}

params.default_queue = 'mit_normal'
params.gpu_queue = 'mit_normal_gpu'

// Runtimes are defined by https://orcd-docs.mit.edu/running-jobs/overview/#partitions
params.max_normal_runtime_in_minutes = 12*60 + 'm'
params.max_gpu_runtime_in_minutes = 6*60 + 'm'

// The largest memory request seen to run on mit_normal. DANDI's per-user QOS memory cap is below 512 GB.
params.max_memory = 256.GB

apptainer {
    enabled = true
    autoMounts = true
    apptainer.enabled = true
    apptainer.autoMounts = true
    platform = 'linux/amd64'
    // From pipeline release 1.4.1 the visualization step publishes through Figpack, and skips itself without a key.
    envWhitelist = ['FIGPACK_API_KEY', 'FIGPACK_UPLOAD', 'FIGPACK_BUCKET', 'NUMBA_CACHE_DIR', 'HDF5_USE_FILE_LOCKING', 'HF_HOME']
}

// The containers bind $HOME, so Python in them would otherwise import the user's own site packages.
env {
    PYTHONNOUSERSITE = 1
}

process {
    executor = 'slurm'
    queue = params.default_queue
    debug = true

    // From pipeline release 1.5.0 the input folder links to the blob, and Nextflow only mounts the folder.
    // Blobs are in either partition.
    containerOptions = "--bind \$HOME:\$HOME,/orcd/data/dandi/001:/orcd/data/dandi/001,/orcd/data/dandi/002:/orcd/data/dandi/002"

    // Steps ask for a small memory and scale it with each attempt. SLURM's cgroup OOM kill exits 137.
    // Retrying stops once an attempt already ran at the cap, since a further one could only ask for the same.
    resourceLimits = [cpus: 16, memory: params.max_memory, time: 12.h]
    errorStrategy = { task.exitStatus == 137 && task.memory < params.max_memory ? 'retry' : 'terminate' }
    maxRetries = 3

    withName: save_provenance {
        cpus=1
        memory={ 2.GB * task.attempt }
        time='15m'
    }
    withName: job_dispatch {
        cpus=4
        memory={ 32.GB * task.attempt }
        time=params.max_normal_runtime_in_minutes
    }
    withName: preprocessing {
        cpus=16
        memory={ 64.GB * task.attempt }
        time=params.max_normal_runtime_in_minutes
    }
    withName: spikesort_kilosort4 {
        cpus=16
        memory='64 GB'
        containerOptions='--nv'
        clusterOptions='--gres=gpu:1'
        queue=params.gpu_queue ?: params.default_queue
        time=params.max_gpu_runtime_in_minutes
        errorStrategy='terminate'
    }
    withName: spikesort_kilosort25 {
        cpus=16
        memory='64 GB'
        containerOptions='--nv'
        clusterOptions='--gres=gpu:1'
        queue=params.gpu_queue ?: params.default_queue
        time=params.max_gpu_runtime_in_minutes
        errorStrategy='terminate'
    }
    withName: spikesort_spykingcircus2 {
        cpus=16
        memory={ 64.GB * task.attempt }
        time=params.max_normal_runtime_in_minutes
    }
    withName: spikesort_lupin {
        cpus=16
        memory={ 64.GB * task.attempt }
        time=params.max_normal_runtime_in_minutes
    }
    withName: spikesort_dartsort {
        cpus=16
        memory='64 GB'
        containerOptions='--nv'
        clusterOptions='--gres=gpu:1'
        queue=params.gpu_queue ?: params.default_queue
        time=params.max_gpu_runtime_in_minutes
        errorStrategy='terminate'
    }
    withName: postprocessing {
        cpus=16
        memory={ 64.GB * task.attempt }
        time=params.max_normal_runtime_in_minutes
    }
    withName: curation {
        cpus=4
        memory={ 32.GB * task.attempt }
        time=params.max_normal_runtime_in_minutes
    }
    withName: visualization {
        cpus=4
        memory={ 32.GB * task.attempt }
        time=params.max_normal_runtime_in_minutes
    }
    withName: results_collector {
        cpus=4
        memory={ 32.GB * task.attempt }
        time=params.max_normal_runtime_in_minutes
    }
    withName: quality_control {
        cpus=16
        memory={ 48.GB * task.attempt }
        time=params.max_normal_runtime_in_minutes
    }
    withName: quality_control_collector {
        cpus=4
        memory={ 32.GB * task.attempt }
        time=params.max_normal_runtime_in_minutes
    }
    withName: nwb_subject {
        cpus=4
        memory={ 32.GB * task.attempt }
        time=params.max_normal_runtime_in_minutes
    }
    withName: nwb_ecephys {
        cpus=4
        memory={ 96.GB * task.attempt }
        time=params.max_normal_runtime_in_minutes
    }
    withName: nwb_units {
        cpus=4
        memory={ 32.GB * task.attempt }
        time=params.max_normal_runtime_in_minutes
    }
}


dag {
    enabled = true
    file = RESULTS_PATH + '/nextflow/dag.html'
    overwrite = true
}

report {
    enabled = true
    file = RESULTS_PATH + '/nextflow/report.html'
    overwrite = true
}

timeline {
    enabled = true
    file = RESULTS_PATH + '/nextflow/timeline.html'
    overwrite = true
}

trace {
    enabled = true
    file = RESULTS_PATH + '/nextflow/trace.txt'
    overwrite = true
}
