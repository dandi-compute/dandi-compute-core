// A local-executor counterpart of `name-mit+engaging_revision-9.config` for GitHub-hosted runners.
// It keeps that config's plugin, environment and reports, swaps SLURM and Apptainer for the local
// executor and Docker, and sizes every step to the 4 CPUs and 16 GB of a standard `ubuntu-latest` runner.
params.executor = "local"

plugins {
    id 'nf-schema@2.7.3'
}

params.max_memory = 14.GB

docker {
    enabled = true
    platform = 'linux/amd64'
    // As on the cluster, the input folder holds only a link to the blob, so the blob's own folder is mounted too.
    runOptions = '--volume $BLOB_DIRECTORY:$BLOB_DIRECTORY:ro --user $(id -u):$(id -g)'
    envWhitelist = ['NUMBA_CACHE_DIR', 'HDF5_USE_FILE_LOCKING', 'HF_HOME']
}

env {
    PYTHONNOUSERSITE = 1
    // The container user has no writable home, so the caches the steps write go to the task directory.
    NUMBA_CACHE_DIR = '/tmp/numba_cache'
    HF_HOME = '/tmp/hf_home'
    MPLCONFIGDIR = '/tmp/mplconfig'
}

process {
    executor = 'local'
    debug = true
    containerOptions = '--memory-swap=-1 --memory-swappiness 20 --shm-size=4g'

    // Every step takes the whole runner, so the local executor runs them one at a time.
    // A failure stops the run. Retrying with more memory, as revision 9 does, has no headroom here.
    cpus = 4
    memory = params.max_memory
    resourceLimits = [cpus: 4, memory: params.max_memory]
    errorStrategy = 'terminate'

    withName: save_provenance {
        cpus = 1
        memory = 2.GB
    }
}

dag {
    enabled = true
    file = RESULTS_PATH + '/nextflow/dag.html'
    overwrite = true
}

report {
    enabled = true
    file = RESULTS_PATH + '/nextflow/report.html'
    overwrite = true
}

timeline {
    enabled = true
    file = RESULTS_PATH + '/nextflow/timeline.html'
    overwrite = true
}

trace {
    enabled = true
    file = RESULTS_PATH + '/nextflow/trace.txt'
    overwrite = true
    fields = 'task_id,name,status,exit,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,duration'
}
